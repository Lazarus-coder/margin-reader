{
  "name": "margin-reader",
  "productName": "Margin",
  "version": "1.3.0",
  "private": true,
  "description": "A discreet, offline desktop reader for Chinese novels: TXT, EPUB, HTML, and Markdown, with the four classic novels included.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src electron scripts/dev.mjs tests *.ts *.json index.html README.md",
    "release:local": "npm run build && node scripts/release.mjs",
    "format:check": "prettier --check src electron scripts/*.mjs tests *.ts *.json index.html README.md README.zh-CN.md CONTRIBUTING.md CHANGELOG.md"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.4.5",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.0",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "reader",
    "chinese",
    "novel",
    "txt",
    "epub",
    "markdown",
    "electron",
    "offline",
    "desktop",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lazarus-coder/margin-reader.git"
  },
  "homepage": "https://github.com/Lazarus-coder/margin-reader#readme",
  "bugs": {
    "url": "https://github.com/Lazarus-coder/margin-reader/issues"
  },
  "author": "Margin contributors"
}
